# Public client configuration (safe to expose in browser)
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Target PostgreSQL connection (server/CI only; never use a VITE_ prefix)
DATABASE_URL=postgresql://user:password@host:5432/database

# Server-only secrets must be configured in the hosting dashboard, never committed:
# SUPABASE_SERVICE_ROLE_KEY=
# CLOUDY_CONTENT_SUPABASE_URL=
# CLOUDY_CONTENT_SUPABASE_SERVICE_ROLE_KEY=
# CLOUDY_MEDIA_PROCESSOR_URL=
# CLOUDY_MEDIA_PROCESSOR_TOKEN=
# AI provider credentials (for example OPENAI_API_KEY or GEMINI_API_KEY) are also server-only.
